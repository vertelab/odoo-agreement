<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <record id="agreement_form_view_tag_extended" model="ir.ui.view">
        <field name="name">agreement.form</field>
        <field name="model">agreement</field>
        <field name="inherit_id" ref="agreement_legal.partner_agreement_form_view"/>
        <field name="arch" type="xml">
            <field name="code" position="after">
                <field name="tag_ids" widget="many2many_tags" options="{'color_field': 'color'}"/>
            </field>
        </field>
    </record>

    <record id="agreement_search_tag_extended" model="ir.ui.view">
        <field name="name">agreement.search</field>
        <field name="model">agreement</field>
        <field name="inherit_id" ref="agreement.agreement_search"/>
        <field name="arch" type="xml">
            <xpath expr="//group" positon="inside">
                <filter
                    name="group_tag_ids"
                    string="Tags"
                    context="{'group_by': 'tag_ids'}"
                />
            </xpath>
        </field>
    </record>
</odoo>
