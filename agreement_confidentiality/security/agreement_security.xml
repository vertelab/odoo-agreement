<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="confidential_agreement_rule" model="ir.rule">
        <field name="name">Confidential Agreement</field>
        <field name="model_id" ref="agreement.model_agreement" />
        <field name="domain_force">
            [
                '|',
                ('is_confidential', '=', False),
                '&amp;',
                ('is_confidential', '=', True),
                ('message_partner_ids', 'child_of', [user.commercial_partner_id.id])
            ]
        </field>
        <field name="perm_unlink" eval="True"/>
        <field name="perm_write" eval="True"/>
        <field name="perm_read" eval="True"/>
        <field name="perm_create" eval="True"/>
    </record>

</odoo>
