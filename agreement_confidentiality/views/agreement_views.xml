<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="agreement_confidential_form_view" model="ir.ui.view">
        <field name="name">agreement.form</field>
        <field name="model">agreement</field>
        <field name="inherit_id" ref="agreement_legal.partner_agreement_form_view"/>
        <field name="arch" type="xml">
            <field name="assigned_user_id" position="after">
                <field name="is_confidential"/>
            </field>
            <xpath expr="//widget[1]" position="after">
                <widget name="web_ribbon" title="Confidential" bg_color="bg-danger" invisible="is_confidential == False"/>
            </xpath>
        </field>
    </record>

    <record id="agreement_confidential_search_view" model="ir.ui.view">
        <field name="name">agreement.search</field>
        <field name="model">agreement</field>
        <field name="inherit_id" ref="agreement_legal.partner_agreement_search_view"/>
        <field name="arch" type="xml">
            <filter name="group_status" position="after">
                <filter
                    name="group_agreement_confidential"
                    string="Confidential"
                    context="{'group_by':'is_confidential'}"
                />
            </filter>
        </field>
    </record>
</odoo>
