<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <record id="agreement_form_view_extended" model="ir.ui.view">
        <field name="name">agreement.form</field>
        <field name="model">agreement</field>
        <field name="inherit_id" ref="agreement_legal.partner_agreement_form_view"/>
        <field name="arch" type="xml">
            <field name="code" position="after">
                <field name="agreement_category_id"/>
            </field>
        </field>
    </record>

    <record id="agreement_search_extended" model="ir.ui.view">
        <field name="name">agreement.search</field>
        <field name="model">agreement</field>
        <field name="inherit_id" ref="agreement_legal.partner_agreement_search_view"/>
        <field name="arch" type="xml">
            <field name="name" position="after">
                <field name="agreement_category_id"/>
            </field>
        </field>
    </record>
</odoo>
